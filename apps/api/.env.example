# Copy to .env, fill in real values, never commit .env itself.
PORT=3001
WEB_ORIGIN=http://localhost:5173
COOKIE_SECRET=

# Auth (PRD §10.1)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback
SESSION_TTL_MINUTES=60

# Dev-only roster login (routes/devAuth.ts) — set to true to log in by
# picking a name from the roster instead of Google OAuth, for testing on
# a machine/browser where Google OAuth isn't set up. NEVER set true in
# production; the server also refuses to mount the route if NODE_ENV is
# "production" regardless of this flag.
DEV_LOGIN=false

# Database (PRD §5, §18) — see DEPLOYMENT.md for the two supported paths.
# Both are the same DATABASE_URL shape; switching between them is this one
# line, never a code change (src/db.ts only ever talks plain Postgres).
#
# Session 9 hardening pass: DATABASE_URL and MIGRATION_DATABASE_URL are
# now deliberately different roles. DATABASE_URL is what the running app
# uses for every request — it MUST be the restricted `nexus_app` role
# (NOSUPERUSER NOBYPASSRLS, created by 0001_init.sql), never the
# superuser role, or every RLS tenant-isolation policy in this schema
# silently stops applying (DECISIONS.md §3 — "RLS has no effect on
# superuser/BYPASSRLS roles"). MIGRATION_DATABASE_URL is only used by
# `npm run migrate` (src/scripts/migrate.ts) and needs to be the
# superuser/bootstrap role instead, since migrations create roles and
# functions. See DEPLOYMENT.md for the full walkthrough.
#
# Local dev, no account (docker-compose.yml at repo root):
#   MIGRATION_DATABASE_URL=postgresql://nexus:nexus_dev_only_change_me@localhost:5432/nexus
#   DATABASE_URL=postgresql://nexus_app:change_me_in_env@localhost:5432/nexus
#
# Supabase Cloud (free tier to start — Settings > Database > Connection string):
#   MIGRATION_DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
#   DATABASE_URL=postgresql://nexus_app:[NEXUS_APP_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
MIGRATION_DATABASE_URL=
DATABASE_URL=

# Calendar (PRD §10.5) — same Google Cloud OAuth client as login above,
# but a distinct redirect URI: this flow requests offline access + the
# calendar scope (see calendarOAuthService.ts), login's does not.
GOOGLE_CALENDAR_OAUTH_REDIRECT_URI=http://localhost:3001/api/v1/calendar/oauth/callback
# Public HTTPS origin Google can reach to deliver push notifications
# (routes/calendarWebhook.ts). Leave unset in local dev — channel
# registration is skipped entirely (calendarSyncService.ts's
# maybeRegisterChannel) and the reconciliation sweep below is what syncs.
CALENDAR_WEBHOOK_BASE_URL=
# Signs/verifies the per-subscription webhook channel token. Falls back
# to a dev-only value if unset — set a real secret for any deployment
# that sets CALENDAR_WEBHOOK_BASE_URL.
CALENDAR_WEBHOOK_TOKEN_SECRET=
# Shared secret for the cross-org reconciliation sweep
# (routes/calendarMaintenance.ts POST /sweep), called by an external
# scheduler (n8n/cron), not a NEXUS session. Endpoint 503s if this is unset.
CALENDAR_MAINTENANCE_SECRET=

# Automation (PRD §10.6 / §12, Phase H) — shared secret for the nine §12
# scheduled-job trigger endpoints (routes/automationMaintenance.ts
# POST /run/:jobKey), same shape as CALENDAR_MAINTENANCE_SECRET above:
# called by an external scheduler (n8n Cloud, one scheduled workflow per
# job at that job's own time, or plain cron-job.org hits), not a NEXUS
# session. Endpoint 503s if this is unset. Use ONE secret for both
# calendar and automation maintenance, or two different ones — either
# works, this just needs to match whatever the scheduler is configured
# to send in the X-Nexus-Maintenance-Secret header for these routes.
AUTOMATION_MAINTENANCE_SECRET=

# Billing (Session 47, PRD §10.9 / SESSION_47_SCOPE_BILLING.md) — Paystack.
# PAYSTACK_SECRET_KEY is the one credential paystackProvider.ts needs for
# both API calls (checkout init/verify) and webhook signature
# verification (routes/billingWebhook.ts's own HMAC check). Get it from
# the Paystack dashboard (test or live secret key). Routes 503 with
# PaystackNotConfiguredError if this is unset — same "lazy config, scoped
# failure" posture objectStorageProvider.ts already establishes for
# storage.
PAYSTACK_SECRET_KEY=

# Plan codes from the Paystack dashboard (Products > Plans), one per
# paid BILLING_TIERS key (packages/shared). routes/billing.ts's
# /checkout resolves the right one for the tier requested;
# billingWebhookService.ts's planCodeToTier does the reverse on the way
# back in. Leaving one unset means checkout for that tier alone 503s
# (not a hard requirement to set both at once).
PAYSTACK_PLAN_CODE_STARTER=
PAYSTACK_PLAN_CODE_PRO=

# Shared secret for the billing grace-period sweep trigger
# (routes/billingMaintenance.ts POST /run — automationJobs.ts's
# runBillingGraceCheck), same external-scheduler shape as
# AUTOMATION_MAINTENANCE_SECRET above. Deliberately its own separate
# secret, not reused from AUTOMATION_MAINTENANCE_SECRET — see
# billingMaintenance.ts's own comment on why these are different trust
# boundaries. Endpoint 503s if unset.
BILLING_MAINTENANCE_SECRET=

# AI (PRD §10.2) — superseded the old AI_PROVIDER/GEMINI_* env vars.
# The AI connection (base URL, API key, chat/report model, meeting-ingest
# secret) is now configured per-org in the app itself, under
# Settings > Integrations — see 0011_ai_settings.sql. Nothing to set here;
# an org with no saved settings falls back to the free zero-config stub
# provider, same as the old AI_PROVIDER=stub default.

# Email (PRD §10.3)
RESEND_API_KEY=

# Automation (PRD §10.6)
N8N_AGENT_WEBHOOK_URL=

# Web Push (PRD §10.4) — generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@abion.org

# Object storage (PRD §10.7 FileService / §13.1 S5) — S3-compatible, so
# any of R2 / AWS S3 / Supabase Storage's S3 endpoint work unchanged; see
# objectStorageProvider.ts. STORAGE_REGION defaults to 'auto' (R2); set a
# real region for AWS S3. STORAGE_ENDPOINT unset resolves to AWS S3's own
# default endpoint — set it for R2/Supabase Storage.
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Optional override of the 25MB default (see fileService.ts). Leave blank
# to use the default — deliberately parsed with `||` not `??` so a
# present-but-blank value here doesn't silently become a 0-byte cap.
STORAGE_MAX_UPLOAD_BYTES=
# Optional override of the org-wide 500MB storage quota default (0023,
# see fileService.ts's getOrgStorageQuota). Same `||` reasoning as
# STORAGE_MAX_UPLOAD_BYTES above — leave blank to use the default. A
# per-org override also exists via organizations.storage_quota_bytes;
# this env var is only the fallback when that column is null.
STORAGE_DEFAULT_ORG_QUOTA_BYTES=
