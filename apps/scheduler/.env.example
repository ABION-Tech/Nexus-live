# Copy to .env, fill in real values, never commit .env itself.
# This process holds NO database credentials — only a URL and the same
# three shared secrets apps/api's own .env.example already defines for
# its maintenance routes. Values here must match apps/api's exactly.

# Where apps/api is reachable from wherever this process runs. Include
# the scheme, no trailing slash (e.g. https://api.example.com, or
# http://localhost:3001 for local dev against apps/api's own default PORT).
API_BASE_URL=

# Must equal apps/api's AUTOMATION_MAINTENANCE_SECRET — used for the
# seven implemented §12 jobs (routes/automationMaintenance.ts).
AUTOMATION_MAINTENANCE_SECRET=

# Must equal apps/api's CALENDAR_MAINTENANCE_SECRET — used for the
# cross-org reconciliation sweep (routes/calendarMaintenance.ts).
CALENDAR_MAINTENANCE_SECRET=

# Must equal apps/api's BILLING_MAINTENANCE_SECRET — used for the daily
# billing grace-period check (routes/billingMaintenance.ts).
BILLING_MAINTENANCE_SECRET=

# IANA timezone the nine §12 job times (08:00, 09:00, etc.) are
# evaluated in. Defaults to Africa/Lagos (NEXUS's own operating
# timezone) if unset — override for a different deployment.
SCHEDULER_TZ=Africa/Lagos

# Per-request timeout in ms before a maintenance call is aborted.
# Defaults to 30000. A fan-out across every org with a job enabled can
# legitimately take longer than a single-org request would.
SCHEDULER_REQUEST_TIMEOUT_MS=30000

# Set to 'true' to run every implemented job once immediately at
# startup, in addition to (not instead of) its normal schedule — useful
# as a one-time smoke test right after deploying this process or
# rotating a secret. Leave unset/false otherwise; do NOT leave this on
# in a process that restarts often, or every implemented job re-runs on
# every restart.
RUN_ON_START=false

# Per-job cron override, one env var per job, none of which need to be
# set — each already has a sane built-in default (see src/jobs.ts).
# Only set one of these to change a single job's time without touching
# code. Standard 5-field cron syntax, evaluated in SCHEDULER_TZ above.
# CRON_DAILY_OVERDUE_CHECK=
# CRON_DAILY_MORNING_DIGEST=
# CRON_DAILY_DEPENDENCY_SWEEP=
# CRON_DAILY_COB_REMINDERS=
# CRON_DAILY_FOLLOW_UP_ESCALATION=
# CRON_DAILY_EOD_NUDGE=
# CRON_DAILY_TASK_SNAPSHOT=
# CRON_CALENDAR_SWEEP=
# CRON_BILLING_GRACE_CHECK=

# Optional pino log level (default 'info').
LOG_LEVEL=info
